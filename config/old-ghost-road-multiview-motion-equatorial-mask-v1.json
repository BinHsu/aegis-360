{
  "schemaVersion": "aegis360.multiview-motion-config.v1",
  "configId": "old-ghost-road-fps25-causal4-equatorial-bottom-third-mask-v1",
  "proxy": {"width": 4096, "height": 2048, "sampleFps": 25.0},
